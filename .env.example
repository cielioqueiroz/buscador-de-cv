GEMINI_API_KEY=
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Rate limit distribuído (opcional, recomendado em produção).
# Sem estas variáveis o app usa um limiter em memória por instância; com elas,
# o teto por IP vale para o app inteiro — o que protege a cota paga do Gemini
# num app aberto.
#
# Na Vercel, a integração "Upstash for Redis" (Storage) injeta automaticamente
# KV_REST_API_URL e KV_REST_API_TOKEN — o código também aceita esses nomes.
# Para config manual (ou local), use os nomes do Upstash abaixo
# (https://upstash.com → REST API). Só a URL/token REST importam; ignore
# KV_URL e REDIS_URL (são conexão TCP, não REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Banco (Neon Postgres) — Fase 0 do PRD "perfil com login".
# A string pooled vem do painel do Neon ("Pooled connection"); use essa aqui.
# A unpooled é só para rodar migrations fora do app.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth (NextAuth v5). AUTH_SECRET: `openssl rand -base64 32`.
# AUTH_URL: só em dev; em prod a Vercel preenche sozinha a partir do deployment.
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-mail transacional (Resend). Em dev, sem a chave, o reset de senha imprime
# o link no console. Em produção, as duas variáveis são obrigatórias — a rota
# `/api/auth/forgot-password` lança sem elas.
RESEND_API_KEY=
EMAIL_FROM=
